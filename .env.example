# Optional: run-web and Compose default to portable directories below the
# repository. Set the explicit paths independently when large mutable data
# should live on a separate disk.
OWRT_REPO_HOST_PATH=/absolute/path/to/openwrt_package
OWRT_STATE_HOST_PATH=/absolute/path/to/openwrt_package/.owrt-web/state
OWRT_WORKSPACE_HOST_PATH=/absolute/path/to/openwrt_package/.owrt-web/workspace
OWRT_ARTIFACT_HOST_PATH=/absolute/path/to/openwrt_package/.owrt-web/state/artifacts
OWRT_CLI_WORKSPACE_HOST_PATH=/absolute/path/to/openwrt_package/.owrt

# Legacy grouped root. It remains supported when the four explicit variables
# above are unset; its state/workspace/artifact subdirectories are used.
# OWRT_DATA_HOST_PATH=/absolute/path/to/openwrt-builder-data

# Direct single-container Web binding.
OWRT_WEB_PORT=8000
OWRT_PUBLIC_ORIGIN=http://127.0.0.1:8000
# Optional comma-separated origins. Set this to * only when the service must
# accept changing public IPs/domains; valid HTTP(S) Origins still need the
# CSRF token for state-changing requests.
OWRT_ALLOWED_ORIGINS=*
OWRT_SECURE_COOKIE=0
OWRT_TRUST_PROXY=0

# Optional PushPlus notification token. Keep this file private.
PUSHPLUS_TOKEN=
