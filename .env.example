# Absolute paths are required because the Web process asks the host Docker
# daemon to mount these same paths into each compiler container.
OWRT_REPO_HOST_PATH=/absolute/path/to/openwrt_package
OWRT_DATA_HOST_PATH=/absolute/path/to/openwrt-builder-data

# Public deployment:
OWRT_DOMAIN=builder.example.com
OWRT_PUBLIC_ORIGIN=https://builder.example.com
# Optional comma-separated origins. Set this to * only when the service must
# accept changing public IPs/domains; valid HTTP(S) Origins still need the
# CSRF token for state-changing requests.
OWRT_ALLOWED_ORIGINS=
OWRT_SECURE_COOKIE=1
OWRT_TRUST_PROXY=1

# Direct Web binding. Keep loopback when using Caddy; set 0.0.0.0 only when
# intentionally serving the Web process directly on port 8000.
OWRT_WEB_BIND_ADDRESS=127.0.0.1

# Optional PushPlus notification token. Keep this file private.
PUSHPLUS_TOKEN=
