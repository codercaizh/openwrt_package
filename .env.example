# Optional: run-web and Compose default to the repository and .owrt-web
# sibling directory. Override these only when persistent data lives elsewhere.
OWRT_REPO_HOST_PATH=/absolute/path/to/openwrt_package
OWRT_DATA_HOST_PATH=/absolute/path/to/openwrt-builder-data

# Direct single-container Web binding.
OWRT_WEB_PORT=8000
OWRT_PUBLIC_ORIGIN=http://127.0.0.1:8000
# Optional comma-separated origins. Set this to * only when the service must
# accept changing public IPs/domains; valid HTTP(S) Origins still need the
# CSRF token for state-changing requests.
OWRT_ALLOWED_ORIGINS=*
OWRT_SECURE_COOKIE=0
OWRT_TRUST_PROXY=0

# Optional PushPlus notification token. Keep this file private.
PUSHPLUS_TOKEN=
