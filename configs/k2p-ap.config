# BUILD VARIANT: K2P-AP (bridge-only access point, NOT a gateway)
# IMPORTANT: This is NOT the K2P router/PassWall image.
# Phicomm K2P A1/A2 / MT7621, 16 MiB NOR flash.
# Dedicated bridged wireless AP; excludes router-only services.
# NOTE: Configure management LAN IP and bridge/Wi-Fi via LuCI after flashing.
# Do not use this image on Broadcom-based K2P B1.
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y
CONFIG_TARGET_PROFILE="DEVICE_phicomm_k2p"

# Minimal LuCI Web management. Do not select the luci meta-package:
# luci -> luci-light -> luci-app-firewall and luci-proto-ppp.
CONFIG_PACKAGE_luci=n
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

# Packet capture, wired/wireless link status and bridge inspection.
# The mini variant avoids bundling full tcpdump and extra diagnostic tools.
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_ip-bridge=y

# An AP bridges traffic and must not run a second DNS/DHCP, NAT or PPP stack.
# It does not need router UI, package management, or manufacturer presets.
CONFIG_PACKAGE_dnsmasq-full=n
CONFIG_PACKAGE_firewall4=n
CONFIG_PACKAGE_nftables=n
CONFIG_PACKAGE_kmod-nft-offload=n
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd-ipv6only=n
CONFIG_PACKAGE_ppp=n
CONFIG_PACKAGE_ppp-mod-pppoe=n
CONFIG_PACKAGE_luci-app-firewall=n
CONFIG_PACKAGE_luci-proto-ppp=n
CONFIG_PACKAGE_luci-app-package-manager=n
CONFIG_PACKAGE_default-settings-chn=n
CONFIG_PACKAGE_block-mount=n
CONFIG_PACKAGE_kmod-nf-nathelper=n
