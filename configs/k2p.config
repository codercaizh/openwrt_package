# BUILD VARIANT: K2P-ROUTER (standard gateway + PassWall)
# Phicomm K2P A1/A2 (MediaTek MT7621, 16 MiB NOR), not K2P B1.
# Default LuCI, DHCP/DNS, firewall4/NFT, PPPoE, LAN/WAN, Wi-Fi included
# from official ImmortalWrt v25.12.2 device/target defaults.
# Only optional third-party UI is PassWall. Strictly avoid large proxy cores.
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y
CONFIG_TARGET_PROFILE="DEVICE_phicomm_k2p"

# Standard router network stack required even if upstream defaults change.
# Preserve DHCP/DNS, firewall4, WAN PPPoE, IPv6 and Wi-Fi.
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_wpad-openssl=y

# Standard router management and essential tools.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_ip-bridge=y

# One third-party plugin: PassWall, using firewall4 nftables TProxy.
# PassWall requires dnsmasq-full and ip-full, as defined by upstream.
CONFIG_PACKAGE_luci-app-passwall=y
# CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy is not set
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y

# The smallest built-in usable proxy backend. Supports ShadowsocksR, not
# Xray/VLESS/Reality or Hysteria2; those exceed this stock-flash budget.
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set

# Only one default SSR client is required; disable obsolete or heavy extras.
# Core dnsmasq-full / IPFull selections are resolved by PassWall dependencies.
# No lucky, tailscale, frpc, pushbot, cloudflarespeedtest, or other LuCI plugins.
