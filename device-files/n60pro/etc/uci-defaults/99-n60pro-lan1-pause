#!/bin/sh

. /lib/functions.sh

find_lan1_device() {
	local name
	config_get name "$1" name
	[ "$name" = "lan1" ] && lan1_section="$1"
	return 0
}

lan1_section=
config_load network || exit 1
config_foreach find_lan1_device device

if [ -z "$lan1_section" ]; then
	lan1_section="$(uci -q add network device)" || exit 1
	uci -q set "network.$lan1_section.name=lan1" || exit 1
fi

# Keep TX pause enabled and disable RX pause on lan1 only.
uci -q set "network.$lan1_section.pause=1" &&
	uci -q set "network.$lan1_section.asym_pause=1" &&
	uci -q set "network.$lan1_section.rxpause=0" &&
	uci -q set "network.$lan1_section.txpause=1" &&
	uci -q commit network
