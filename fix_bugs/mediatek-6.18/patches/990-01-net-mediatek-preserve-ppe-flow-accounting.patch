From f3fa889cb32fd5fb6f0e38292ad96ee2c710ba4e Mon Sep 17 00:00:00 2001
From: Alexander Goodkind <alex@goodkind.io>
Date: Thu, 22 Oct 2026 06:44:38 -0700
Subject: [PATCH] net: ethernet: mediatek: preserve PPE flow accounting

PPE counter updates can lose a slot's counters during rebinding or add
the same cached counters after each statistics request. Clearing bindings
for other slots in the same hash bucket also stops their counter updates.

Read the hardware counters and save them once before clearing a slot
association. Finish the bucket scan before binding the selected flow,
and initialize the reported totals under ppe_lock. Preserve bindings for
other slots and skip decreasing totals when reporting traffic increments.

Counter saving follows Valentin Berezhnoy's accounting patch. Deferred
binding and the locked statistics snapshot follow Chad Monroe's patch.

Fixes: c4f033d9e03e ("net: ethernet: mtk_eth_soc: rework hardware flow table management")
Link: https://github.com/openwrt/openwrt/pull/26107
Link: https://github.com/openwrt/openwrt/pull/26081
Link: https://github.com/cmonroe/target-cascade/blob/smartrg-master/cascade/patches-6.18/990-34-13-smartrg-net-ethernet-mtk_ppe-count-each-bind-of-a-flow-once.patch
Signed-off-by: Alexander Goodkind <alex@goodkind.io>
[Adapt for ImmortalWrt Linux 6.18 after WED priority and DSA patches.
 Keep the first matching flow's WED priority check and RX metadata.
 When a bridge subflow detaches during binding, carry its saved counts
 into the L2 parent before rebinding or freeing it.]
---
--- a/drivers/net/ethernet/mediatek/mtk_ppe.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe.c
@@ -792,6 +792,24 @@
 		return now - timestamp;
 }
 
+/* Save the slot counters before a later bind resets them. */
+static struct mtk_foe_accounting *
+mtk_flow_entry_detach(struct mtk_ppe *ppe, struct mtk_flow_entry *entry)
+{
+	struct mtk_foe_accounting *acct;
+
+	if (entry->hash == 0xffff)
+		return NULL;
+
+	acct = mtk_ppe_mib_entry_read(ppe, entry->hash);
+	if (acct) {
+		entry->prev_packets += acct->packets;
+		entry->prev_bytes += acct->bytes;
+	}
+	entry->hash = 0xffff;
+	return acct;
+}
+
 static bool
 mtk_flow_entry_update(struct mtk_ppe *ppe, struct mtk_flow_entry *entry,
 		      u64 *packets, u64 *bytes)
@@ -812,12 +830,7 @@
 
 	if (!mtk_flow_entry_match(ppe->eth, entry, &foe, len) ||
 	    FIELD_GET(MTK_FOE_IB1_STATE, foe.ib1) != MTK_FOE_STATE_BIND) {
-		acct = mtk_ppe_acct_data(ppe, hash);
-		if (acct) {
-			entry->prev_packets += acct->packets;
-			entry->prev_bytes += acct->bytes;
-		}
-
+		acct = mtk_flow_entry_detach(ppe, entry);
 		goto out;
 	}
 
@@ -868,11 +881,11 @@
 void mtk_foe_entry_get_stats(struct mtk_ppe *ppe, struct mtk_flow_entry *entry,
 			     int *idle)
 {
+	spin_lock_bh(&ppe_lock);
+
 	entry->packets = entry->prev_packets;
 	entry->bytes = entry->prev_bytes;
 
-	spin_lock_bh(&ppe_lock);
-
 	if (entry->type == MTK_FLOW_TYPE_L2)
 		mtk_flow_entry_update_l2(ppe, entry);
 	else
@@ -988,6 +1001,7 @@
 		return;
 
 	flow_info->type = MTK_FLOW_TYPE_L2_SUBFLOW;
+	flow_info->l2_parent = entry;
 	flow_info->hash = hash;
 	flow_info->wed_index = entry->wed_index;
 	flow_info->wcid = entry->wcid;
@@ -1031,7 +1045,7 @@
 	const struct mtk_soc_data *soc = ppe->eth->soc;
 	struct hlist_head *head = &ppe->foe_flow[hash / soc->hash_offset];
 	struct mtk_foe_entry *hwe = mtk_foe_get_entry(ppe, hash);
-	struct mtk_flow_entry *entry;
+	struct mtk_flow_entry *entry, *bound = NULL;
 	struct mtk_foe_bridge key = {};
 	struct mtk_foe_entry foe = {};
 	struct hlist_node *n;
@@ -1066,23 +1080,38 @@
 	dscp = mtk_ppe_skb_dscp(skb);
 
 	hlist_for_each_entry_safe(entry, n, head, list) {
-		if (found ||
-		    !mtk_flow_entry_match(ppe->eth, entry, &foe, entry_len)) {
-			if (entry->hash != 0xffff)
-				__mtk_foe_entry_clear(ppe, entry, false);
-			continue;
-		}
+		bool matches = !found &&
+			mtk_flow_entry_match(ppe->eth, entry, &foe, entry_len);
 
-		found = true;
-		if (!mtk_foe_entry_set_prio(ppe, entry, &entry->data, dscp)) {
-			entry->hash = 0xffff;
+		if (!matches && entry->hash != hash)
 			continue;
+
+		mtk_flow_entry_detach(ppe, entry);
+		if (entry->type == MTK_FLOW_TYPE_L2_SUBFLOW) {
+			struct mtk_flow_entry *parent = entry->l2_parent;
+
+			parent->prev_packets += entry->prev_packets;
+			parent->prev_bytes += entry->prev_bytes;
+			entry->prev_packets = 0;
+			entry->prev_bytes = 0;
+		}
+		if (matches) {
+			found = true;
+			if (mtk_foe_entry_set_prio(ppe, entry, &entry->data, dscp)) {
+				bound = entry;
+				continue;
+			}
 		}
 
-		entry->rx_wed_index = rx_wed_index;
-		entry->rx_wcid = rx_wcid;
-		entry->hash = hash;
-		__mtk_foe_entry_commit(ppe, &entry->data, hash);
+		__mtk_foe_entry_clear(ppe, entry, false);
+	}
+
+	/* Save the old owner's counters before resetting the slot. */
+	if (bound) {
+		bound->rx_wed_index = rx_wed_index;
+		bound->rx_wcid = rx_wcid;
+		bound->hash = hash;
+		__mtk_foe_entry_commit(ppe, &bound->data, hash);
 	}
 
 	if (found)
--- a/drivers/net/ethernet/mediatek/mtk_ppe.h
+++ b/drivers/net/ethernet/mediatek/mtk_ppe.h
@@ -305,6 +305,7 @@
 		struct {
 			struct hlist_node list;
 			struct hlist_node l2_list;
+			struct mtk_flow_entry *l2_parent;
 		};
 		/* L2 flows */
 		struct {
--- a/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
@@ -633,8 +633,11 @@
 	packets = entry->packets;
 	bytes = entry->bytes;
 	mtk_foe_entry_get_stats(eth->ppe[entry->ppe_index], entry, &idle);
-	f->stats.pkts += entry->packets - packets;
-	f->stats.bytes += entry->bytes - bytes;
+	/* Do not report a decreasing total as an unsigned traffic increment. */
+	if (entry->packets > packets)
+		f->stats.pkts += entry->packets - packets;
+	if (entry->bytes > bytes)
+		f->stats.bytes += entry->bytes - bytes;
 	f->stats.lastused = jiffies - idle * HZ;
 
 	return 0;
