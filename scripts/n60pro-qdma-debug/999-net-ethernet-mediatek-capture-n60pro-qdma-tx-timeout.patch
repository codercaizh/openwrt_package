+static void mtk_n60pro_tx_snapshot(struct mtk_eth *eth, struct net_device *dev,
+				  int txqueue, u32 fe_status,
+				  bool reset_allowed, const char *monitor_reason)
+{
+	static DEFINE_RATELIMIT_STATE(watchdog_limit, 15 * HZ, 1);
+	static DEFINE_RATELIMIT_STATE(monitor_limit, 5 * HZ, 1);
+	const struct mtk_reg_map *map = eth->soc->reg_map;
+	struct mtk_tx_ring *ring = &eth->tx_ring;
+	unsigned int i;
+	u32 page;
+
+	if (!eth->tx_diag_enabled ||
+	    !__ratelimit(dev ? &watchdog_limit : &monitor_limit))
+		return;
+
+	dev_warn(eth->dev,
+		 "n60pro-qdma: trigger=%s netdev=%s queue=%d monitor=%s fe_status=%08x fe_seen=%08x reset_allowed=%u dma_users=%u\n",
+		 dev ? "tx-watchdog" : "dma-monitor", dev ? dev->name : "-",
+		 txqueue, monitor_reason, fe_status, atomic_read(&eth->tx_diag_fe_errors),
+		 reset_allowed, refcount_read(&eth->dma_refcnt));
+	dev_warn(eth->dev,
+		 "n60pro-qdma: glo=%08x next=%08x ctx=%08x dtx=%08x crx=%08x drx=%08x fq=%08x doorbells=%u underestimate=%u\n",
+		 mtk_r32(eth, map->qdma.glo_cfg), READ_ONCE(eth->tx_diag_cpu_next),
+		 mtk_r32(eth, map->qdma.ctx_ptr),
+		 mtk_r32(eth, map->qdma.dtx_ptr), mtk_r32(eth, map->qdma.crx_ptr),
+		 mtk_r32(eth, map->qdma.drx_ptr), mtk_r32(eth, map->qdma.fq_count),
+		 READ_ONCE(eth->tx_diag_doorbells),
+		 READ_ONCE(eth->tx_diag_desc_underestimates));
+	dev_warn(eth->dev,
+		 "n60pro-qdma: qfsm=%08x qfwd=%08x monitor_hang_wdma=%u qdma=%u adma=%u\n",
+		 mtk_r32(eth, map->qdma.qtx_cfg + 0x234),
+		 mtk_r32(eth, map->qdma.qtx_cfg + 0x308),
+		 READ_ONCE(eth->reset.wdma_hang_count), READ_ONCE(eth->reset.qdma_hang_count),
+		 READ_ONCE(eth->reset.adma_hang_count));
+	dev_warn(eth->dev,
+		 "n60pro-qdma: ring_phys=%pad free=%d size=%d thresh=%u last_free=%08x blocked=%u blocked_ptr=%08x txd3/4/5=%08x/%08x/%08x\n",
+		 &ring->phys, atomic_read(&ring->free_count), READ_ONCE(ring->dma_size),
+		 READ_ONCE(ring->thresh), READ_ONCE(ring->last_free_ptr),
+		 READ_ONCE(eth->tx_diag_blocked), READ_ONCE(eth->tx_diag_blocked_ptr),
+		 READ_ONCE(eth->tx_diag_blocked_txd3), READ_ONCE(eth->tx_diag_blocked_txd4),
+		 READ_ONCE(eth->tx_diag_blocked_txd5));
+	dev_warn(eth->dev,
+		 "n60pro-qdma: tx_irq=%08x tx_mask=%08x napi_state=%lx polls=%u last_work=%u\n",
+		 mtk_r32(eth, map->tx_irq_status), mtk_r32(eth, map->tx_irq_mask),
+		 READ_ONCE(eth->tx_napi.state), READ_ONCE(eth->tx_diag_polls),
+		 READ_ONCE(eth->tx_diag_last_work));
+	dev_warn(eth->dev,
+		 "n60pro-qdma: pse_free=%08x iq=%08x/%08x oq=%08x/%08x/%08x gdm_fsm=%08x/%08x\n",
+		 mtk_r32(eth, MTK_FE_PSE_FREE), mtk_r32(eth, map->pse_iq_sta),
+		 mtk_r32(eth, map->pse_iq_sta + 4), mtk_r32(eth, map->pse_oq_sta),
+		 mtk_r32(eth, map->pse_oq_sta + 4), mtk_r32(eth, map->pse_oq_sta + 0x10),
+		 mtk_r32(eth, MTK_FE_GDM1_FSM), mtk_r32(eth, MTK_FE_GDM2_FSM));
+	dev_warn(eth->dev,
+		 "n60pro-qdma: fq_head=%08x fq_tail=%08x fe_irq_enable=%08x ppe0_glo/tb=%08x/%08x ppe1_glo/tb=%08x/%08x\n",
+		 mtk_r32(eth, map->qdma.fq_head), mtk_r32(eth, map->qdma.fq_tail),
+		 mtk_r32(eth, MTK_FE_INT_ENABLE),
+		 mtk_r32(eth, map->ppe_base + MTK_PPE_GLO_CFG),
+		 mtk_r32(eth, map->ppe_base + MTK_PPE_TB_CFG),
+		 mtk_r32(eth, map->ppe_base + 0x400 + MTK_PPE_GLO_CFG),
+		 mtk_r32(eth, map->ppe_base + 0x400 + MTK_PPE_TB_CFG));
+	dev_warn(eth->dev,
+		 "n60pro-qdma: wdma_idx/cfg/fifo=%08x/%08x/%08x adma_rx=%08x cdm1_fsm=%08x\n",
+		 mtk_r32(eth, map->wdma_base[0] + 0xc),
+		 mtk_r32(eth, map->wdma_base[0] + 0x204),
