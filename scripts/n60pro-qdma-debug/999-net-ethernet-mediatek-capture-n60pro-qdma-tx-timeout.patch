+static void mtk_n60pro_tx_sample(struct mtk_eth *eth)
+{
+	const struct mtk_reg_map *map = eth->soc->reg_map;
+	struct mtk_tx_diag_sample sample;
+	unsigned long flags;
+
+	if (!eth->tx_diag_enabled || !refcount_read(&eth->dma_refcnt))
+		return;
+
+	sample = (struct mtk_tx_diag_sample) {
+		.stamp = jiffies,
+		.cpu_next = READ_ONCE(eth->tx_diag_cpu_next),
+		.ctx = mtk_r32(eth, map->qdma.ctx_ptr),
+		.dtx = mtk_r32(eth, map->qdma.dtx_ptr),
+		.crx = mtk_r32(eth, map->qdma.crx_ptr),
+		.drx = mtk_r32(eth, map->qdma.drx_ptr),
+		.irq = mtk_r32(eth, map->tx_irq_status),
+		.mask = mtk_r32(eth, map->tx_irq_mask),
+		.irq_events = READ_ONCE(eth->tx_events),
+		.polls = READ_ONCE(eth->tx_diag_polls),
+		.free = atomic_read(&eth->tx_ring.free_count),
+		.fq = mtk_r32(eth, map->qdma.fq_count),
+		.pse = mtk_r32(eth, MTK_FE_PSE_FREE),
+		.fe = mtk_r32(eth, MTK_INT_STATUS2),
+	};
+	spin_lock_irqsave(&eth->tx_diag_lock, flags);
+	eth->tx_diag_history[eth->tx_diag_history_next] = sample;
+	eth->tx_diag_history_next = (eth->tx_diag_history_next + 1) % MTK_TX_DIAG_HISTORY;
+	if (eth->tx_diag_history_count < MTK_TX_DIAG_HISTORY)
+		eth->tx_diag_history_count++;
+	spin_unlock_irqrestore(&eth->tx_diag_lock, flags);
+}
+
+static void mtk_n60pro_tx_history(struct mtk_eth *eth)
+{
+	struct mtk_tx_diag_sample history[MTK_TX_DIAG_HISTORY];
+	unsigned int count, next, i;
+	unsigned long flags;
+
+	spin_lock_irqsave(&eth->tx_diag_lock, flags);
+	count = eth->tx_diag_history_count;
+	next = eth->tx_diag_history_next;
+	memcpy(history, eth->tx_diag_history, sizeof(history));
+	spin_unlock_irqrestore(&eth->tx_diag_lock, flags);
+
+	for (i = 0; i < count; i++) {
+		unsigned int slot = (next + MTK_TX_DIAG_HISTORY - count + i) %
+				    MTK_TX_DIAG_HISTORY;
+		const struct mtk_tx_diag_sample *s = &history[slot];
+
+		dev_warn(eth->dev,
+			 "n60pro-qdma: history age_ms=%u next/ctx/dtx/crx/drx=%08x/%08x/%08x/%08x/%08x irq/mask=%08x/%08x events=%u polls=%u free=%u fq=%08x pse=%08x fe=%08x\n",
+			 jiffies_to_msecs(jiffies - s->stamp), s->cpu_next,
+			 s->ctx, s->dtx, s->crx, s->drx, s->irq, s->mask,
+			 s->irq_events, s->polls, s->free, s->fq, s->pse, s->fe);
+	}
+}
+
+static void mtk_n60pro_tx_last_packets(struct mtk_eth *eth)
+{
+	struct mtk_tx_diag_packet last[MTK_MAX_DEVS];
+	unsigned int i;
+
+	if (!spin_trylock_bh(&eth->page_lock)) {
+		dev_warn(eth->dev, "n60pro-qdma: last packets unavailable, TX lock busy\n");
+		return;
+	}
+	memcpy(last, eth->tx_diag_last, sizeof(last));
+	spin_unlock_bh(&eth->page_lock);
+
+	for (i = 0; i < ARRAY_SIZE(last); i++) {
+		const struct mtk_tx_diag_packet *p = &last[i];
+
+		if (!p->valid)
+			continue;
+		dev_warn(eth->dev,
+			 "n60pro-qdma: last mac=%u queue=%u len=%u proto=%04x hw_vlan=%u tci=%04x gso_type=%08x tso=%u descs=%u estimate=%u next=%08x doorbell=%u\n",
+			 i, p->queue, p->len, p->proto, p->vlan, p->vlan_tci,
+			 p->gso_type, p->tso, p->descs, p->estimate, p->next, p->doorbell);
+	}
+}
