+static void mtk_n60pro_tx_snapshot(struct mtk_eth *eth, struct net_device *dev,
+				  unsigned int txqueue, u32 fe_status,
+				  bool reset_allowed)
+{
+	static DEFINE_RATELIMIT_STATE(limit, 15 * HZ, 1);
+	const struct mtk_reg_map *map = eth->soc->reg_map;
+	struct mtk_tx_ring *ring = &eth->tx_ring;
+	unsigned int i;
+
+	if (map != &mt7986_reg_map ||
+	    !of_machine_is_compatible("netcore,n60-pro") ||
+	    !__ratelimit(&limit))
+		return;
+
+	netdev_warn(dev,
+		    "n60pro-qdma: queue=%u fe_status=%08x reset_allowed=%u dma_users=%u\n",
+		    txqueue, fe_status, reset_allowed, refcount_read(&eth->dma_refcnt));
+	dev_warn(eth->dev,
+		 "n60pro-qdma: glo=%08x ctx=%08x dtx=%08x crx=%08x drx=%08x fq=%08x\n",
+		 mtk_r32(eth, map->qdma.glo_cfg), mtk_r32(eth, map->qdma.ctx_ptr),
+		 mtk_r32(eth, map->qdma.dtx_ptr), mtk_r32(eth, map->qdma.crx_ptr),
+		 mtk_r32(eth, map->qdma.drx_ptr), mtk_r32(eth, map->qdma.fq_count));
+	dev_warn(eth->dev,
+		 "n60pro-qdma: qfsm=%08x qfwd=%08x monitor_hang_wdma=%u qdma=%u adma=%u\n",
+		 mtk_r32(eth, map->qdma.qtx_cfg + 0x234),
+		 mtk_r32(eth, map->qdma.qtx_cfg + 0x308),
+		 READ_ONCE(eth->reset.wdma_hang_count), READ_ONCE(eth->reset.qdma_hang_count),
+		 READ_ONCE(eth->reset.adma_hang_count));
+	dev_warn(eth->dev,
+		 "n60pro-qdma: ring_phys=%pad free=%d size=%d thresh=%u last_free=%08x blocked=%u blocked_ptr=%08x\n",
+		 &ring->phys, atomic_read(&ring->free_count), READ_ONCE(ring->dma_size),
+		 READ_ONCE(ring->thresh), READ_ONCE(ring->last_free_ptr),
+		 READ_ONCE(eth->tx_diag_blocked), READ_ONCE(eth->tx_diag_blocked_ptr));
+	dev_warn(eth->dev,
+		 "n60pro-qdma: tx_irq=%08x tx_mask=%08x napi_state=%lx polls=%u last_work=%u\n",
+		 mtk_r32(eth, map->tx_irq_status), mtk_r32(eth, map->tx_irq_mask),
+		 READ_ONCE(eth->tx_napi.state), READ_ONCE(eth->tx_diag_polls),
+		 READ_ONCE(eth->tx_diag_last_work));
+	dev_warn(eth->dev,
+		 "n60pro-qdma: pse_free=%08x iq=%08x/%08x oq=%08x/%08x/%08x gdm_fsm=%08x/%08x\n",
+		 mtk_r32(eth, MTK_FE_PSE_FREE), mtk_r32(eth, map->pse_iq_sta),
+		 mtk_r32(eth, map->pse_iq_sta + 4), mtk_r32(eth, map->pse_oq_sta),
+		 mtk_r32(eth, map->pse_oq_sta + 4), mtk_r32(eth, map->pse_oq_sta + 0x10),
+		 mtk_r32(eth, MTK_FE_GDM1_FSM), mtk_r32(eth, MTK_FE_GDM2_FSM));
+
+	for (i = 0; i < 2; i++) {
+		struct net_device *ndev = eth->netdev[i];
+		unsigned long driver_stopped = 0, stack_stopped = 0;
+		unsigned int q;
+
+		if (!ndev)
+			continue;
+
+		for (q = 0; q < min_t(unsigned int, ndev->real_num_tx_queues,
+				      BITS_PER_LONG); q++) {
+			unsigned long state = READ_ONCE(netdev_get_tx_queue(ndev, q)->state);
+
+			if (state & BIT(__QUEUE_STATE_DRV_XOFF))
+				driver_stopped |= BIT(q);
+			if (state & BIT(__QUEUE_STATE_STACK_XOFF))
+				stack_stopped |= BIT(q);
+		}
+		netdev_warn(ndev,
+			    "n60pro-qdma: carrier=%u drv_stopped=%lx stack_stopped=%lx mac_status=%08x mac_fsm=%08x gdm_fwd=%08x\n",
+			    netif_carrier_ok(ndev), driver_stopped, stack_stopped,
+			    mtk_r32(eth, MTK_MAC_MSR(i)), mtk_r32(eth, MTK_MAC_FSM(i)),
+			    mtk_r32(eth, MTK_GDMA_FWD_CFG(i)));
+	}
+	dev_warn(eth->dev, "n60pro-qdma: snapshot end\n");
+}
+
 static void mtk_tx_timeout(struct net_device *dev, unsigned int txqueue)
 {
 	struct mtk_mac *mac = netdev_priv(dev);
 	struct mtk_eth *eth = mac->hw;
+	bool reset_allowed;
+	u32 fe_status;
 
 	if (test_bit(MTK_RESETTING, &eth->state))
 		return;
 
-	if (!mtk_hw_reset_check(eth))
+	fe_status = mtk_r32(eth, MTK_INT_STATUS2);
+	reset_allowed = mtk_hw_reset_check(fe_status);
+	mtk_n60pro_tx_snapshot(eth, dev, txqueue, fe_status, reset_allowed);
+	if (!reset_allowed)
 		return;
 
 	eth->netdev[mac->id]->stats.tx_errors++;
