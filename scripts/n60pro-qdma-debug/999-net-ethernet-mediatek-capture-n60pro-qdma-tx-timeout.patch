+		dev_warn(eth->dev,
+			 "n60pro-qdma: qtx_page=%08x slot=%u cfg/sch/head/tail=%08x/%08x/%08x/%08x\n",
+			 page, i, mtk_r32(eth, map->qdma.qtx_cfg + offset),
+			 mtk_r32(eth, map->qdma.qtx_sch + offset),
