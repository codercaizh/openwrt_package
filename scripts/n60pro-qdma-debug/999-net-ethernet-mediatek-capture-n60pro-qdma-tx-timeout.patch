+		netdev_warn(ndev,
+			    "n60pro-qdma: carrier=%u drv_stopped=%lx stack_stopped=%lx mac_ctrl=%08x mac_status=%08x mac_fsm=%08x gdm_fwd=%08x\n",
+			    netif_carrier_ok(ndev), driver_stopped, stack_stopped,
