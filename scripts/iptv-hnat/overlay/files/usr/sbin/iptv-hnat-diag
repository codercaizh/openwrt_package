#!/bin/sh
# Runtime diagnostics only; never writes UCI, restarts networking or flashes firmware.
set -eu
D=/sys/kernel/debug/mtk_iptv_diag
H=/sys/kernel/debug/hnat
[ -d "$D" ] || { echo 'IPTV diagnostic kernel is not running' >&2; exit 1; }
command=${1:-status}
seconds=${2:-30}
normal() {
 for f in nf_skip_mask wifi_skip_mask multicast_bypass rx_clear_hnat no_gro legacy_sticky_ppd; do echo 0 > "$D/$f"; done
 echo 4294967295 > "$D/rx_mac"
 echo 0 > "$H/diag_wifi_detach"
 echo 3 > "$H/diag_sma"
}
case "$command" in
 status) cat /etc/iptv-hnat-diag.version; cat "$D/stats"; cat "$D/registers"; exit ;;
 restore) normal; echo 0 > "$D/enable"; echo 'Fixed RX path, normal HNAT controls restored'; exit ;;
 capture|matrix) ;;
 *) echo 'Usage: iptv-hnat-diag status | capture [seconds] | matrix [seconds] | restore' >&2; exit 2 ;;
esac
[ -e "$H/diag_wifi_detach" ] && [ -e "$H/diag_sma" ] || { echo "Diagnostic HNAT module is not loaded" >&2; exit 1; }
case "$seconds" in ''|*[!0-9]*) exit 2;; esac
[ "$seconds" -ge 5 ] && [ "$seconds" -le 90 ] || { echo 'seconds must be 5..90' >&2; exit 2; }
# Multiple simultaneous matrices would invalidate controls and rollback.
LOCK=/tmp/iptv-hnat-diag.lock
mkdir "$LOCK" 2>/dev/null || { echo 'Another diagnostic run/lock exists; inspect /tmp/iptv-hnat-diag.lock' >&2; exit 1; }
OUT=$(mktemp -d /tmp/iptv-hnat-diag.XXXXXX)
restore_file="$OUT/restore.sh"
printf '#!/bin/sh\n' > "$restore_file"
for f in enable nf_skip_mask wifi_skip_mask multicast_bypass rx_clear_hnat no_gro legacy_sticky_ppd rx_mac dst src port vlan sample_every; do
 v=$(cat "$D/$f"); printf 'echo %s > %s\n' "$v" "$D/$f" >> "$restore_file"
done
for f in diag_wifi_detach diag_sma; do
 v=$(cat "$H/$f"); printf 'echo %s > %s\n' "$v" "$H/$f" >> "$restore_file"
done
curl_pid=; cap_pid=; guard_pid=
cleanup() {
 trap - EXIT HUP INT TERM
 [ -z "$curl_pid" ] || kill "$curl_pid" 2>/dev/null || true
 [ -z "$cap_pid" ] || kill -INT "$cap_pid" 2>/dev/null || true
 sh "$restore_file"
 touch "$OUT/DONE"
 [ -z "$guard_pid" ] || kill "$guard_pid" 2>/dev/null || true
 rmdir "$LOCK" 2>/dev/null || true
 echo "Results: $OUT (controls restored)"
}
trap cleanup EXIT HUP INT TERM
# Survives SSH loss / a killed parent; all control values are numeric root-owned debugfs values.
nohup sh -c 'sleep 1200; [ -f "$1/DONE" ] || sh "$1/restore.sh"' sh "$OUT" > "$OUT/watchdog.log" 2>&1 < /dev/null &
guard_pid=$!
stage_count=1
[ "$command" != matrix ] || stage_count=6
stage_kb=$((seconds * 1024)); [ "$stage_kb" -le 33000 ] || stage_kb=33000
required_kb=$((stage_kb * stage_count + 8192))
available_kb=$(df -k /tmp | awk 'END { print $4 }')
[ "$available_kb" -ge "$required_kb" ] || { echo "Insufficient /tmp space: need ${required_kb}KB, have ${available_kb}KB" >&2; exit 1; }
cp /etc/iptv-hnat-diag.version "$OUT/version"
ip -o link show > "$OUT/interfaces.txt"
# No complete network/firewall configs or arbitrary kernel log dump.
snapshot() {
 dir=$1
 cat "$D/stats" > "$dir/stats"
 cat "$D/events" > "$dir/events"
 cat "$D/registers" > "$dir/registers"
 cat "$H/hook_toggle" > "$dir/hook_toggle"
 cat "$H/hnat_stats" > "$dir/hnat_stats"
 cat /proc/net/softnet_stat > "$dir/softnet_stat"
 ethtool -S eth1 > "$dir/eth1-stats" 2>/dev/null || true
}
# Decode the host-order IPv4 filter without relying on Lua/Python.
addr=$(cat "$D/dst"); addr=$((addr))
group="$(((addr >> 24) & 255)).$(((addr >> 16) & 255)).$(((addr >> 8) & 255)).$((addr & 255))"
port=$(cat "$D/port")
[ "$addr" -ne 0 ] && [ "$port" -gt 0 ] && [ "$port" -le 65535 ] || { echo 'capture requires a concrete dst/port filter' >&2; exit 2; }
run_stage() {
 name=$1; dir="$OUT/$name"; mkdir "$dir"
 echo 1 > "$D/reset"; echo 1 > "$D/enable"
 snapshot "$dir"
 # Short cooked headers, bounded 4 x 8 MB ring; no full video recording.
 if command -v tcpdump >/dev/null 2>&1; then
  tcpdump -ni any -y LINUX_SLL2 -s 64 -B 8192 -C 8 -W 4 -w "$dir/rtp.pcap" \
    "udp and dst host $group and dst port $port" > "$dir/tcpdump.log" 2>&1 &
  cap_pid=$!
 fi
 curl -fsS -D "$dir/http-headers" --max-time "$((seconds + 5))" "http://127.0.0.1:5140/rtp/$group:$port" -o /dev/null > "$dir/curl.log" 2>&1 &
 curl_pid=$!
 sleep "$seconds"
 kill "$curl_pid" 2>/dev/null || true; wait "$curl_pid" 2>/dev/null || true; curl_pid=
 if [ -n "$cap_pid" ]; then
  kill -INT "$cap_pid" 2>/dev/null || true; wait "$cap_pid" 2>/dev/null || true; cap_pid=
 fi
 mkdir "$dir/after"; snapshot "$dir/after"
 echo "$name complete: $dir"
}
if [ "$command" = capture ]; then
 run_stage current
else
 # Legacy is explicit reproduction of the upstream defect, not the installed default.
 normal; run_stage fixed-a
 echo 1 > "$D/legacy_sticky_ppd"; run_stage legacy
 echo 8191 > "$D/nf_skip_mask"; run_stage legacy-nf-bypass
 echo 0 > "$D/nf_skip_mask"; echo 3 > "$H/diag_wifi_detach"; run_stage legacy-wifi-detached
 echo 8191 > "$D/nf_skip_mask"; run_stage legacy-nf-and-wifi-bypass
 normal; run_stage fixed-b
fi
