From: Codex <noreply@openai.com>
Subject: [PATCH] mediatek: scope sent_ppd per RX descriptor and add bounded RTP diagnostics

Fix a batch-scoped redirect flag introduced by 9999-02-mtk_enhance.patch.
Diagnostics and legacy reproduction are runtime controlled and off by default.

--- a/drivers/net/ethernet/mediatek/Makefile
+++ b/drivers/net/ethernet/mediatek/Makefile
@@ -12,3 +12,5 @@
 obj-$(CONFIG_NET_MEDIATEK_SOC_WED) += mtk_wed_ops.o
 obj-$(CONFIG_NET_MEDIATEK_STAR_EMAC) += mtk_star_emac.o
 obj-$(CONFIG_NET_MEDIATEK_HNAT) += mtk_hnat/
+
+mtk_eth-y += mtk_iptv_diag.o
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -33,6 +33,7 @@
 #include <net/page_pool/helpers.h>
 
 #include "mtk_eth_soc.h"
+#include "mtk_iptv_diag.h"
 #include "mtk_eth_dbg.h"
 #include "mtk_wed.h"
 
@@ -2470,6 +2471,8 @@
 	dma_addr_t dma_addr = DMA_MAPPING_ERROR;
 	int ppe_idx = 0;
 	int sent_ppd = 0;
+	bool iptv_latched = false;
+	u32 iptv_trigger = 0, iptv_poll = mtk_iptv_poll_id();
 
 	if (unlikely(!ring))
 		goto rx_done;
@@ -2479,6 +2482,13 @@
 		struct net_device *netdev;
 		u32 hash, reason;
 		int mac = 0;
+		struct mtk_iptv_packet iptv = {};
+		bool iptv_current_ppd = false;
+		int iptv_fail = 0;
+
+		/* sent_ppd belongs to this descriptor, never to the NAPI batch. */
+		if (likely(!READ_ONCE(mtk_iptv_legacy_ppd)))
+			sent_ppd = 0;
 
 		idx = NEXT_DESP_IDX(ring->calc_idx, ring->dma_size);
 		rxd = ring->dma + idx * eth->soc->rx.desc_size;
@@ -2507,12 +2517,53 @@
 			mac = RX_DMA_GET_SPORT(trxd.rxd4) - 1;
 		}
 
+		/* Read only after DMA synchronization; restore ownership before the
+		 * original RX path runs. Never inspect more than the DMA buffer. */
+		if (mtk_iptv_active() && mtk_is_netsys_v2_or_greater(eth) &&
+		    !mtk_is_netsys_v3_or_greater(eth)) {
+			u32 plen = RX_DMA_GET_PLEN0(trxd.rxd2);
+			u32 head = ring->page_pool ? MTK_PP_HEADROOM :
+				   NET_SKB_PAD + eth->ip_align;
+			dma_addr_t da;
+			enum dma_data_direction dir = DMA_FROM_DEVICE;
+			if (ring->page_pool) {
+				da = page_pool_get_dma_addr(virt_to_head_page(data)) + head;
+				dir = page_pool_get_dma_dir(ring->page_pool);
+			} else {
+				da = (u64)trxd.rxd1;
+				if (MTK_HAS_CAPS(eth->soc->caps, MTK_36BIT_DMA))
+					da |= RX_DMA_GET_ADDR64(trxd.rxd2);
+			}
+			if (plen >= ETH_HLEN && plen <= ring->buf_size) {
+				u32 n = min_t(u32, plen, 128);
+				dma_sync_single_for_cpu(eth->dma_dev, da, n, dir);
+				mtk_iptv_raw(&iptv, data + head, plen, trxd.rxd4, mac, ring->ring_no);
+				dma_sync_single_for_device(eth->dma_dev, da, n, dir);
+				iptv.poll_id = iptv_poll; iptv.desc_idx = idx;
+				iptv.trigger_rxd = iptv_trigger;
+				mtk_iptv_record(0, &iptv, 0);
+			}
+		}
+
 		if ( (mac == 4) || ((FIELD_GET(MTK_RXD4_PPE_CPU_REASON, trxd.rxd4)) == HIT_BIND_FORCE_TO_CPU))
 		{
 		
 		mac = atomic_read(&eth1_in_br);
 		sent_ppd = 1;
-		}
+		iptv_current_ppd = true; iptv_latched = true;
+		iptv_trigger = trxd.rxd4;
+		mtk_iptv_count(15);
+		}
+		if (iptv.valid && iptv_latched && !iptv_current_ppd) {
+			iptv.trigger_rxd = iptv_trigger;
+			mtk_iptv_count(14);
+			/* action 5: legacy code would misroute this ordinary packet. */
+			mtk_iptv_record(4, &iptv, 5);
+		}
+		if (iptv.valid && READ_ONCE(mtk_iptv_rx_mac) >= 0 &&
+		    READ_ONCE(mtk_iptv_rx_mac) < MTK_MAX_DEVS)
+			mac = READ_ONCE(mtk_iptv_rx_mac);
+		iptv_fail = 1;
 		if (unlikely(mac < 0 || mac >= MTK_MAX_DEVS ||
 			     !eth->netdev[mac]))
 			goto release_desc;
@@ -2520,11 +2571,13 @@
 		netdev = eth->netdev[mac];
 		ppe_idx = eth->mac[mac]->ppe_idx;
 
+		iptv_fail = 2;
 		if (unlikely(test_bit(MTK_RESETTING, &eth->state)))
 			goto release_desc;
 
 		pktlen = RX_DMA_GET_PLEN0(trxd.rxd2);
 
+		iptv_fail = 3;
 		/* alloc new buffer */
 		if (ring->page_pool) {
 			struct page *page = virt_to_head_page(data);
@@ -2552,9 +2605,12 @@
 			if (ret == XDP_REDIRECT)
 				xdp_flush = true;
 
-			if (ret != XDP_PASS)
+			if (ret != XDP_PASS) {
+				iptv_fail = 4;
 				goto skip_rx;
-
+			}
+
+			iptv_fail = 5;
 			skb = napi_build_skb(data, PAGE_SIZE);
 			if (unlikely(!skb)) {
 				page_pool_put_full_page(ring->page_pool,
@@ -2593,6 +2649,7 @@
 			dma_unmap_single(eth->dma_dev, ((u64)trxd.rxd1 | addr64),
 					 ring->buf_size, DMA_FROM_DEVICE);
 
+			iptv_fail = 5;
 			skb = napi_build_skb(data, ring->frag_size);
 			if (unlikely(!skb)) {
 				netdev->stats.rx_dropped++;
@@ -2604,7 +2661,10 @@
 			skb_put(skb, pktlen);
 		}
 
+		iptv_fail = 0;
 		skb->dev = netdev;
+		iptv.mac = mac; iptv.ifindex = netdev->ifindex;
+		mtk_iptv_record(1, &iptv, 0);
 		bytes += skb->len;
 
 		if (mtk_is_netsys_v3_or_greater(eth)) {
@@ -2650,6 +2710,10 @@
 		skb_hnat_alg(skb) = 0;
 		skb_hnat_filled(skb) = 0;
 		skb_hnat_magic_tag(skb) = HNAT_MAGIC_TAG;
+		if (iptv.valid && READ_ONCE(mtk_iptv_clear_hnat)) {
+			skb_hnat_alg(skb) = 1; skb_hnat_magic_tag(skb) = 0;
+			mtk_iptv_count(10);
+		}
 
 		if (skb_hnat_reason(skb) == HIT_BIND_FORCE_TO_CPU) {
 			trace_printk("[%s] reason=0x%x(force to CPU) from WAN to Ext\n",
@@ -2676,13 +2740,25 @@
 		skb->dev = ppd_dev;
 		skb->mark = 0x78681415;
 		}
+		iptv.ifindex = skb->dev->ifindex;
+		mtk_iptv_record(2, &iptv, 0);
 		skb_record_rx_queue(skb, 0);
-		napi_gro_receive(napi, skb);
+		if (iptv.valid && READ_ONCE(mtk_iptv_no_gro)) {
+			mtk_iptv_count(12);
+			netif_receive_skb(skb);
+		} else {
+			mtk_iptv_count(11);
+			napi_gro_receive(napi, skb);
+		}
 
 skip_rx:
 		ring->data[idx] = new_data;
 		rxd->rxd1 = (unsigned int)dma_addr;
 release_desc:
+		if (iptv_fail) {
+			mtk_iptv_count(iptv_fail + 3);
+			mtk_iptv_record(3, &iptv, 4);
+		}
 		if (MTK_HAS_CAPS(eth->soc->caps, MTK_36BIT_DMA)) {
 			if (unlikely(dma_addr == DMA_MAPPING_ERROR))
 				addr64 = FIELD_GET(RX_DMA_ADDR64_MASK,
@@ -6814,6 +6890,8 @@
 	debug_proc_init(eth);
 
 	platform_set_drvdata(pdev, eth);
+	if (mtk_is_netsys_v2_or_greater(eth) && !mtk_is_netsys_v3_or_greater(eth))
+		mtk_iptv_init(eth->base);
 	schedule_delayed_work(&eth->reset.monitor_work,
 			      MTK_DMA_MONITOR_TIMEOUT);
 
@@ -6836,6 +6914,7 @@
 
 static int mtk_remove(struct platform_device *pdev)
 {
+	mtk_iptv_exit();
 	struct mtk_eth *eth = platform_get_drvdata(pdev);
 	struct mtk_mac *mac;
 	int i;
--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat.c
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat.c
@@ -24,6 +24,8 @@
 
 #include "nf_hnat_mtk.h"
 #include "hnat.h"
+#include "../mtk_iptv_diag.h"
+static u32 iptv_sma = SMA_FWD_CPU_BUILD_ENTRY;
 
 struct mtk_hnat *hnat_priv;
 static struct socket *_hnat_roam_sock;
@@ -51,7 +53,7 @@
 
 	for (i = 0; i < CFG_PPE_NUM; i++)
 		cr_set_field(hnat_priv->ppe_base[i] + PPE_TB_CFG,
-			     SMA, SMA_FWD_CPU_BUILD_ENTRY);
+			     SMA, READ_ONCE(iptv_sma));
 }
 
 void hnat_cache_ebl(int enable)
@@ -572,6 +574,27 @@
 	.notifier_call = nf_hnat_netevent_handler,
 };
 
+/* Independent controls: do not clear bindings or unregister NF hooks. */
+void hnat_iptv_wifi(u32 mask)
+{
+	WRITE_ONCE(mtk_iptv_wifi_skip, mask);
+	WRITE_ONCE(ra_sw_nat_hook_tx, (hook_toggle && hnat_priv->data->whnat && !(mask & 1)) ? mtk_sw_nat_hook_tx : NULL);
+	WRITE_ONCE(ra_sw_nat_hook_rx, (hook_toggle && hnat_priv->data->whnat && !(mask & 2) &&
+		hnat_priv->data->version == MTK_HNAT_V4) ? mtk_sw_nat_hook_rx : NULL);
+	synchronize_net();
+}
+int hnat_iptv_sma(u64 value)
+{
+	int i;
+	if (value != SMA_ONLY_FWD_CPU && value != SMA_FWD_CPU_BUILD_ENTRY) return -EINVAL;
+	WRITE_ONCE(iptv_sma, value);
+	del_timer_sync(&hnat_priv->hnat_sma_build_entry_timer);
+	for (i = 0; i < CFG_PPE_NUM; i++)
+		cr_set_field(hnat_priv->ppe_base[i] + PPE_TB_CFG, SMA, value);
+	return 0;
+}
+u32 hnat_iptv_sma_get(void) { return READ_ONCE(iptv_sma); }
+
 int hnat_enable_hook(void)
 {
 	/* register hook functions used by WHNAT module.
@@ -590,6 +613,7 @@
 
 	ppe_del_entry_by_mac = entry_delete_by_mac;
 	hook_toggle = 1;
+	hnat_iptv_wifi(READ_ONCE(mtk_iptv_wifi_skip));
 
 	return 0;
 }
--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat.h
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat.h
@@ -1023,3 +1023,7 @@
 {
 	return (readl(hnat_priv->fe_base + 0x0010)) & 0xffff;
 }
+
+void hnat_iptv_wifi(u32 mask);
+int hnat_iptv_sma(u64 value);
+u32 hnat_iptv_sma_get(void);
--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c
@@ -28,6 +28,7 @@
 #include <net/netfilter/nf_conntrack_acct.h>
 #include "nf_hnat_mtk.h"
 #include "hnat.h"
+#include "../mtk_iptv_diag.h"
 
 #include "../mtk_eth_soc.h"
 #include "../mtk_eth_reset.h"
@@ -1980,6 +1981,12 @@
 
 int mtk_sw_nat_hook_tx(struct sk_buff *skb, int gmac_no)
 {
+	mtk_iptv_count(0);
+	if (READ_ONCE(mtk_iptv_wifi_skip) & 1) {
+		mtk_iptv_count(2);
+		return NF_ACCEPT;
+	}
+
 	struct foe_entry *entry;
 	struct ethhdr *eth;
 	struct hnat_bind_info_blk bfib1_tx;
@@ -2169,6 +2176,12 @@
 
 int mtk_sw_nat_hook_rx(struct sk_buff *skb)
 {
+	mtk_iptv_count(1);
+	if (READ_ONCE(mtk_iptv_wifi_skip) & 2) {
+		mtk_iptv_count(3);
+		return NF_ACCEPT;
+	}
+
 	if (!IS_SPACE_AVAILABLE_HEAD(skb) || !FROM_WED(skb)) {
 		skb_hnat_magic_tag(skb) = 0;
 		return NF_ACCEPT;
@@ -2858,14 +2871,50 @@
 	},
 };
 
+/* Preserve a packet snapshot before the original callback can consume skb. */
+static struct nf_hook_ops iptv_nf_ops[ARRAY_SIZE(mtk_hnat_nf_ops)];
+static unsigned int iptv_nf_hook(void *priv, struct sk_buff *skb,
+				const struct nf_hook_state *state)
+{
+	struct nf_hook_ops *op = priv;
+	unsigned int id = op - mtk_hnat_nf_ops, ret;
+	struct mtk_iptv_packet packet = {};
+	u32 raw = 0;
+	mtk_iptv_count(16 + id);
+	if (mtk_iptv_active()) {
+		if (skb && IS_SPACE_AVAILABLE_HEAD(skb) && is_magic_tag_valid(skb))
+			memcpy(&raw, skb->head, sizeof(raw));
+		mtk_iptv_skb(&packet, skb, raw);
+		mtk_iptv_record(IPTV_NF_BASE + id, &packet, 0);
+	}
+	if ((READ_ONCE(mtk_iptv_nf_skip) & BIT(id)) ||
+	    (READ_ONCE(mtk_iptv_bypass) && packet.valid)) {
+		mtk_iptv_record(IPTV_NF_EXIT_BASE + id, &packet, 3);
+		return NF_ACCEPT;
+	}
+	ret = op->hook(op->priv, skb, state);
+	if ((ret & NF_VERDICT_MASK) == NF_DROP) mtk_iptv_count(32 + id);
+	if ((ret & NF_VERDICT_MASK) == NF_STOLEN) mtk_iptv_count(48 + id);
+	mtk_iptv_record(IPTV_NF_EXIT_BASE + id, &packet,
+		(ret & NF_VERDICT_MASK) == NF_DROP ? 1 :
+		(ret & NF_VERDICT_MASK) == NF_STOLEN ? 2 : 0);
+	return ret;
+}
+
 int hnat_register_nf_hooks(void)
 {
-	return nf_register_net_hooks(&init_net, mtk_hnat_nf_ops, ARRAY_SIZE(mtk_hnat_nf_ops));
+	unsigned int i;
+	for (i = 0; i < ARRAY_SIZE(iptv_nf_ops); i++) {
+		iptv_nf_ops[i] = mtk_hnat_nf_ops[i];
+		iptv_nf_ops[i].hook = iptv_nf_hook;
+		iptv_nf_ops[i].priv = &mtk_hnat_nf_ops[i];
+	}
+	return nf_register_net_hooks(&init_net, iptv_nf_ops, ARRAY_SIZE(iptv_nf_ops));
 }
 
 void hnat_unregister_nf_hooks(void)
 {
-	nf_unregister_net_hooks(&init_net, mtk_hnat_nf_ops, ARRAY_SIZE(mtk_hnat_nf_ops));
+	nf_unregister_net_hooks(&init_net, iptv_nf_ops, ARRAY_SIZE(iptv_nf_ops));
 }
 
 int whnat_adjust_nf_hooks(void)
--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c
@@ -18,6 +18,7 @@
 #include <linux/iopoll.h>
 
 #include "hnat.h"
+#include "../mtk_iptv_diag.h"
 #include "nf_hnat_mtk.h"
 #include "../mtk_eth_soc.h"
 
@@ -2136,6 +2137,17 @@
 	dump_register(CAH_RDATA),
 };
 
+static int iptv_wifi_get(void *data, u64 *val) { *val = READ_ONCE(mtk_iptv_wifi_skip); return 0; }
+static int iptv_wifi_set(void *data, u64 val)
+{
+	if (val > 3) return -EINVAL;
+	hnat_iptv_wifi(val); return 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(iptv_wifi_fops, iptv_wifi_get, iptv_wifi_set, "%llu\n");
+static int iptv_sma_get(void *data, u64 *val) { *val = hnat_iptv_sma_get(); return 0; }
+static int iptv_sma_set(void *data, u64 val) { return hnat_iptv_sma(val); }
+DEFINE_DEBUGFS_ATTRIBUTE(iptv_sma_fops, iptv_sma_get, iptv_sma_set, "%llu\n");
+
 int hnat_init_debugfs(struct mtk_hnat *h)
 {
 	int ret = 0;
@@ -2150,6 +2162,8 @@
 		goto err0;
 	}
 	h->root = root;
+	debugfs_create_file("diag_wifi_detach", 0600, root, h, &iptv_wifi_fops);
+	debugfs_create_file("diag_sma", 0600, root, h, &iptv_sma_fops);
 
 	for (i = 0; i < CFG_PPE_NUM; i++) {
 		h->regset[i] = kzalloc(sizeof(*h->regset[i]), GFP_KERNEL);
